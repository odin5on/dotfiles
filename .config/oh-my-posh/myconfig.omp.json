  {
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "diamond",
          "template": "@{{ .UserName }} ",
          "foreground": "#A3BE8C",
          "background": "#3A404B",
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": "<#3A404B,transparent></>"
        },
        {
          "type": "path",
          "style": "diamond",
          "template": " {{ .Path }}{{ if .Segments.Contains \"Git\" }} {{ else }}<#3A404B,transparent></><#56B6C2,transparent> </>{{ end }}",
          "foreground": "#56B6C2",
          "background": "#3A404B",
          "properties": {
            "cache_duration": "none",
            "home_icon": "~",
            "style": "full"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "template": " {{ .HEAD }}",
          "foreground": "#FFE082",
          "background": "#3A404B",
          "properties": {
            "branch_icon": "",
            "cache_duration": "none"
          },
          "alias": "Git",
          "trailing_diamond": "<#3A404B,transparent></> "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "template": "{{ if .Code }} <#3A404B,transparent></><#FF5C57,#3A404B> exit {{ .Code }}</><#3A404B,transparent></>{{ end }}",
          "foreground": "#FF5C57",
          "background": "transparent",
          "properties": {
            "always_enabled": false,
            "cache_duration": "none"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "template": "{{ if or .Ahead .Behind (and .Upstream .UpstreamGone) }} <#3A404B,transparent></><#FFE082,#3A404B>{{ if .Ahead }} {{ .Ahead }}{{ end }}{{ if and .Ahead .Behind }} {{ end }}{{ if .Behind }} {{ .Behind }}{{ end }}{{ if and .Upstream .UpstreamGone }}{{ end }}</><#3A404B,transparent></>{{ end }}",
          "foreground": "#FFE082",
          "background": "transparent",
          "properties": {
            "cache_duration": "none",
            "fetch_status": true
          }
        },
        {
          "type": "git",
          "style": "plain",
          "template": "{{ if or .Working.Changed .Staging.Changed }} <#3A404B,transparent></><#FFE082,#3A404B> {{ add .Working.Added .Working.Modified .Working.Deleted .Working.Unmerged .Working.Untracked }} |  {{ add .Staging.Added .Staging.Modified .Staging.Deleted .Staging.Unmerged .Staging.Untracked }}</><#3A404B,transparent></>{{ end }}",
          "foreground": "#FFE082",
          "background": "transparent",
          "properties": {
            "branch_icon": "",
            "cache_duration": "none",
            "fetch_status": true
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "template": " <#3A404B,transparent></><#A3BE8C,#3A404B>{{ .FormattedMs }}</><#3A404B,transparent></>",
          "foreground": "#A3BE8C",
          "background": "transparent",
          "properties": {
            "always_enabled": true,
            "cache_duration": "none",
            "style": "austin",
            "threshold": 0
          }
        },
        {
          "type": "time",
          "style": "plain",
          "template": " <#3A404B,transparent></><#A3BE8C,#3A404B>{{ .CurrentDate | date .Format }}</><#3A404B,transparent></>",
          "foreground": "#A3BE8C",
          "background": "transparent",
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04:05"
          }
        }
      ],
      "filler": "<#56B6C2>─</>"
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "template": "<#56B6C2>╰─</><#FFE082>❯</> ",
          "template": "<FFE082>❯_</> ",
          "foreground": "#FFE082",
          "properties": {
            "always_enabled": true,
            "cache_duration": "none"
          },
          "background": "transparent",
          "force": true
        }
      ]
    }
  ],
  "version": 3,
  "final_space": false,
  "set_title": true,
  "console_title_template": "{{ .Folder }}"
}
